# Copy this file to .env and fill in real values. Never commit .env.
# DEPLOY.md (French) lists the lines of a server put online.

# REQUIRED unless DJANGO_DEBUG=True: at least 50 random characters, never
# written anywhere else. With DEBUG off, a missing or weak key is refused
# when the settings load. Generate one with:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Changing it logs everybody out, voids the signing codes on their way and
# leaves the logins typed on the « Identifiants » page unreadable (to type again).
DJANGO_SECRET_KEY=

# False unless this is a developer's own machine. True shows Django's debug
# pages - the settings, the paths - to whoever triggers an error; the app
# refuses it beside a public host in DJANGO_ALLOWED_HOSTS (accounts.E007),
# and `manage.py serve` (the production server) turns it off regardless.
DJANGO_DEBUG=False

# The names the server answers to: the public one first when online
# (gestion.example.com), then this machine's.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Online: the site's own https address, e.g. https://gestion.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Online (manage.py serve, behind a Cloudflare Tunnel) ---------------------
# 1 once the site is reached over HTTPS: session and CSRF cookies HTTPS-only,
# HSTS. `manage.py serve` refuses to start without it.
MARGINMATE_HTTPS=
# How long browsers remember to use HTTPS, in seconds. Empty: 3600 (an hour);
# raise it (31536000, a year) once everything works.
MARGINMATE_HSTS_SECONDS=
# The error log (marginmate.log, rotated). Empty: logs/ beside
# MARGINMATE_TENANTS_ROOT's folder.
MARGINMATE_LOG_DIR=

# --- The tenants: one database per bar, a login on every page -----------------
# Every tenant's folder (its database, its files, its signing keys) is kept
# under MARGINMATE_TENANTS_ROOT; the logins, sessions and tenants in the
# accounts database. Put both OUTSIDE the code folder and back them up.
# Empty: "tenants/" and "accounts.sqlite3" beside manage.py - fine on a
# developer's machine; `manage.py serve` refuses it (accounts.E011).
# (MARGINMATE_TENANCY no longer exists: leave it out. Set to anything but
# "multi", the app refuses to start - the old "single" mode is gone.)
MARGINMATE_TENANTS_ROOT=
MARGINMATE_ACCOUNTS_DB=

# The credentials below (Metro, the mailbox, L'Addition, the portals) are
# better typed on the « Identifiants » page (/identifiants/): encrypted in the
# espace's private folder, they win over these lines, which stay a fallback.

# Metro (docs.metro.fr) login used by the Metro invoice scraper.
METRO_EMAIL=
METRO_PASSWORD=

# The mailbox invoices arrive in (with an IMAP "app password", not your
# normal password), searched for every email-based invoice type configured
# under "Types de factures". Any provider serving IMAP over SSL: leave
# INVOICE_IMAP_HOST empty for Gmail, or give yours (outlook.office365.com,
# imap.orange.fr, ...).
INVOICE_EMAIL_ADDRESS=
INVOICE_EMAIL_APP_PASSWORD=
INVOICE_IMAP_HOST=

# Optional. Only used as a last-resort fallback to parse invoices from a
# supplier that has no dedicated regex parser yet.
ANTHROPIC_API_KEY=

# Above this fuzzy-match score (0-100) a new invoice line is auto-linked to an
# existing product instead of being flagged for review. Left to the default
# (94, config/settings.py), measured on the real catalogue: at 92 a long
# "COCA COLA ... 33CL" line merges silently with its "ZERO". Do not lower it.
#PRODUCT_FUZZY_MATCH_THRESHOLD=94

# Keep True unless you need to watch the browser during Metro scraping.
SCRAPER_HEADLESS=True

# --- Personnel: the monthly e-signature of the timesheets --------------------
# The signing keys, the signed PDFs and the proof files are kept in each
# tenant's own private/ folder, under MARGINMATE_TENANTS_ROOT.
# Encrypts the signing keys on disk. SET IT BEFORE THE APP GOES ONLINE, and
# keep it somewhere safe: a key file cannot be opened without it.
MARGINMATE_SIGNING_PASSPHRASE=
# The address the links sent to employees start with, e.g. https://bar.example.fr
MARGINMATE_SITE_URL=
# Optional: RFC 3161 timestamp servers, comma-separated, tried in order.
# Empty = DigiCert, then Sectigo (neither charges anything).
MARGINMATE_TIMESTAMP_URLS=

# Optional: e-mail, to send the signing link, the one-time code and the
# signed copy. Leave EMAIL_HOST empty and nothing is sent (the link and the
# code are then handed over by another channel). Gmail example, with an
# APP PASSWORD (Google account > Security > App passwords), never the
# account's own password:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=(the Gmail address itself)
#   EMAIL_HOST_PASSWORD=(the 16-letter app password Google shows once)
#   DEFAULT_FROM_EMAIL=(optional: "Bar Exemple <the same address>")
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
