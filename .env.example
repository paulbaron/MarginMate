# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Metro (docs.metro.fr) login used by the Metro invoice scraper.
METRO_EMAIL=
METRO_PASSWORD=

# Gmail account (with an IMAP "app password", not your normal password) used
# to fetch invoice emails for every email-based invoice type configured under
# "Types de factures" (Types de factures page), not just UBA.
INVOICE_EMAIL_ADDRESS=
INVOICE_EMAIL_APP_PASSWORD=

# Optional. Only used as a last-resort fallback to parse invoices from a
# supplier that has no dedicated regex parser yet.
ANTHROPIC_API_KEY=

# Above this fuzzy-match score (0-100) a new invoice line is auto-linked to an
# existing product instead of being flagged for review.
PRODUCT_FUZZY_MATCH_THRESHOLD=92

# Keep True unless you need to watch the browser during Metro scraping.
SCRAPER_HEADLESS=True
