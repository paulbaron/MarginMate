# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Metro (docs.metro.fr) login used by the Metro invoice scraper.
METRO_EMAIL=
METRO_PASSWORD=

# The mailbox invoices arrive in (with an IMAP "app password", not your
# normal password), searched for every email-based invoice type configured
# under "Types de factures". Any provider serving IMAP over SSL: leave
# INVOICE_IMAP_HOST empty for Gmail, or give yours (outlook.office365.com,
# imap.orange.fr, ...).
INVOICE_EMAIL_ADDRESS=
INVOICE_EMAIL_APP_PASSWORD=
INVOICE_IMAP_HOST=

# Optional. Only used as a last-resort fallback to parse invoices from a
# supplier that has no dedicated regex parser yet.
ANTHROPIC_API_KEY=

# Above this fuzzy-match score (0-100) a new invoice line is auto-linked to an
# existing product instead of being flagged for review.
PRODUCT_FUZZY_MATCH_THRESHOLD=92

# Keep True unless you need to watch the browser during Metro scraping.
SCRAPER_HEADLESS=True

# --- Personnel: the monthly e-signature of the timesheets --------------------
# Where the signing keys, the signed PDFs and the proof files are kept.
# Leave empty for "private/" beside the database. Never inside media/.
# Back this folder up with the database.
MARGINMATE_PRIVATE_DIR=
# Encrypts the signing keys on disk. SET IT BEFORE THE APP GOES ONLINE, and
# keep it somewhere safe: a key file cannot be opened without it.
MARGINMATE_SIGNING_PASSPHRASE=
# The address the links sent to employees start with, e.g. https://bar.example.fr
MARGINMATE_SITE_URL=
# Optional: RFC 3161 timestamp servers, comma-separated, tried in order.
# Empty = DigiCert, then Sectigo (neither charges anything).
MARGINMATE_TIMESTAMP_URLS=

# Optional: e-mail, to send the signing link, the one-time code and the
# signed copy. Leave EMAIL_HOST empty and nothing is sent (the link and the
# code are then handed over by another channel). Gmail example, with an
# APP PASSWORD (Google account > Security > App passwords), never the
# account's own password:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=(the Gmail address itself)
#   EMAIL_HOST_PASSWORD=(the 16-letter app password Google shows once)
#   DEFAULT_FROM_EMAIL=(optional: "Bar Exemple <the same address>")
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
